# =============================================================================
# LipaFast Environment Variables
# Copy this file to .env.local and fill in real values.
# Without keys, the app falls back to mock data (safe for local MVP).
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LipaFast

# --- Supabase (Database + Auth) ---
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- KYC Provider (Smile Identity / Veriff / Onfido) ---
# Phase 1: mock verification if unset
KYC_PROVIDER=mock
KYC_API_KEY=
KYC_API_SECRET=
KYC_WEBHOOK_SECRET=

# --- Payments: Inbound (Flutterwave / Paystack) ---
# Sandbox keys for USD/EUR collection from international clients
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Payments: Outbound (Mobile Money MTN / Airtel via Flutterwave) ---
# Instant UGX payout to user's mobile money wallet
MOMO_PAYOUT_SECRET_KEY=
MOMO_WEBHOOK_SECRET=

# --- Feature flags ---
# Set to "true" to force mock APIs even when keys are present
USE_MOCK_APIS=true
